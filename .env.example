BENNO_ENV=development
SECRET_KEY=replace-this-development-secret
DATABASE_URL=sqlite:///benno.sqlite3

# Current first implementation path
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional observability for local AI debugging
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_FULL_CONTEXT=false
LANGFUSE_FLUSH_ON_TURN=false
